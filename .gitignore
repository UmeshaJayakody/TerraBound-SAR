# Local-only project material -- kept for reference on this machine, not part
# of the published pipeline.
/.claude/
/RaySAR_1.2/

# Regenerable pipeline output: large, and reproducible by re-running the
# Scripts against a scene's Contributions.txt. Keep the final HR/LR PNG
# results (small, meant to be viewed on GitHub) but drop the bulky
# intermediate/raw data.
RaySAR_Workspace/**/Contributions.txt
RaySAR_Workspace/**/Maps/Frames/**
RaySAR_Workspace/**/Maps/Image_data/**
RaySAR_Workspace/**/*.tif
RaySAR_Workspace/**/*.mat

# Results folders the scripts and GUIs write (regenerate them, don't commit them)
RaySAR_Workspace/Scenes/*_Results/
RaySAR_Workspace/Test_Runs/Step_Results/
RaySAR_Workspace/**/SAR_Results/
RaySAR_Workspace/**/blender_handoff/
sar_live.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Earth Capture: downloaded map data and the datasets it makes
earth_capture/.cache/
/runs/
/datasets/

# OS / editor / MATLAB cruft
Thumbs.db
.DS_Store
*.asv
*.m~
